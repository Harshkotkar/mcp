# ============================================================
# MCP Task Assistant - Environment Configuration Template
# ============================================================

# --- Groq Configuration (Primary & Fallback Models) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b

# --- MCP Server Endpoint ---
MCP_URL=http://127.0.0.1:8000/mcp

# --- SQLite Database Storage ---
DATABASE_PATH=./data/tasks.db

# --- LangSmith Observability ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=mcp_task_assistant

# --- Application Logging ---
LOG_LEVEL=INFO

# --- Optional Pricing (USD per 1M tokens) ---
# GROQ_INPUT_PRICE_PER_1M_TOKENS=0.15
# GROQ_OUTPUT_PRICE_PER_1M_TOKENS=0.60
